# 复制为 .env 使用（.env 不入库）。生产部署用 docker-compose.yml 读取。
# ===== 镜像与端口 =====
# 必须替换为候选完整 Git SHA 派生的不可变标签，例如 sha-<40位Git SHA>；禁止 latest。
APP_IMAGE_TAG=sha-REPLACE_WITH_FULL_GIT_SHA
FRONTEND_PORT=80
# 同时用于宿主发布与 HTTP 301 目标；非默认端口会显式出现在 Location 中。
FRONTEND_HTTPS_PORT=443
# WS-5/T1：生产域名与证书目录。目录内文件名固定为 fullchain.pem / privkey.pem，
# 使用学校签发或 Let's Encrypt 的正式证书；证书私钥文件不得提交仓库。
TLS_SERVER_NAME=cert.example.edu.cn
TLS_CERTIFICATE_DIR=./deploy/certs
# 部署前必须替换为宿主已存在的专用证书读取组的数字 GID，并核对该组名称与成员。
# 它与容器 nginx 的 101:101 无关；目录建议 0750、证书/私钥 0640 root:<该组>，私钥不得全局可读。
TLS_CERTIFICATE_GID=REPLACE_WITH_NUMERIC_DEDICATED_HOST_CERT_GROUP_GID
# 注：backend/MySQL/Redis 不 publish 到宿主；MinIO 两端口只绑定宿主 127.0.0.1，
# API 由 MINIO_PUBLIC_ENDPOINT 对应的 HTTPS 网关转发，console 仅供受控本机运维。
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=teacher_cert
# 应用连接账号（Phase 41.1，P0-5）：非 root 最小权限，由 deploy/mysql-init/01-app-user.sh
# 在数据卷首次初始化时创建（仅 teacher_cert 库 DML+DDL，无 GRANT OPTION/SUPER/FILE/*.*）。
# 必须显式设置强密码，不可留空/沿用示例值。
DB_USERNAME=teacher_app
DB_PASSWORD=change-me-strong-app-db-password
# 应用逻辑备份单条恢复 SQL 的 UTF-8 字节上限；当前实现只支持 1KiB..32MiB，
# 恢复 mysql 客户端和目标服务端均须配置至少 64MiB max_allowed_packet。
BACKUP_MAX_SQL_STATEMENT_BYTES=33554432

# ===== Redis =====
# 生产加密码认证（Phase 41.3），必须显式设置强密码。
REDIS_PASSWORD=change-me-strong-redis-password
# Phase 44 字典缓存写窗口的逐 owner 租约与续租周期。默认分别为 2m/20s；
# 两者必须为正，且 RENEW_INTERVAL <= LEASE/3，所有后端实例必须配置一致，否则启动期拒绝。
DICT_CACHE_WRITER_LEASE=2m
DICT_CACHE_WRITER_RENEW_INTERVAL=20s

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=teacher-cert
# 浏览器可达的 MinIO API 根地址（不能使用 Compose 内部 DNS minio）。HTTPS 站点必须使用同 scheme 的公网端点。
MINIO_PUBLIC_ENDPOINT=https://files.example.edu.cn
MINIO_REGION=us-east-1
MINIO_PRESIGN_EXPIRY_SECONDS=900
# MinIO 公网端点/CORS 故障时可临时设 false，视频和材料将回退为字节经应用上传。
MINIO_DIRECT_UPLOAD_ENABLED=true
# INITIATING/COMPLETING 超过该时限后允许新请求以 CAS 方式恢复，避免进程中断永久占槽。
MINIO_DIRECT_UPLOAD_INIT_TIMEOUT_SECONDS=120
MINIO_DIRECT_UPLOAD_COMPLETE_TIMEOUT_SECONDS=300
# S3 建连/读取均有显式超时；读取超时需覆盖对象存储在正常负载下的最长单次响应间隔。
MINIO_CONNECTION_TIMEOUT_SECONDS=10
MINIO_READ_TIMEOUT_SECONDS=30
# 单次对象存储调用总墙钟；与 30 秒 socket 空闲超时分离，2GB 流式读取不得误用 30 秒总时限。
MINIO_CALL_TIMEOUT_SECONDS=900
# 逗号分隔、含协议与端口。由 MinIO 的 MINIO_API_CORS_ALLOW_ORIGIN 在服务启动时读取；修改后需重建 MinIO 容器。
MINIO_CORS_ALLOWED_ORIGINS=https://cert.example.edu.cn

# ===== 后端 =====
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=change-me-at-least-64-characters-change-me-at-least-64-characters
# WS-5/T2/T3：access token 仅驻前端内存，默认 15 分钟；refresh Cookie 默认 7 天。
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# WS-8：生产必配且两者必须相互独立，也不得复用 JWT_SECRET。AES 密钥为 Base64 编码的随机 32 字节值；
# HMAC pepper 至少 32 个 UTF-8 字节。以下占位值会被生产启动护栏拒绝。
# 上线后两项值必须保持稳定，并在数据库备份之外安全备份；WS-8 不支持在线轮换。
IDCARD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
IDCARD_HMAC_PEPPER=REPLACE_WITH_RANDOM_HMAC_PEPPER_AT_LEAST_32_BYTES
JAVA_OPTS=-Xms512m -Xmx1024m
# 视频媒体探测资源边界。临时目录由 Compose 固定为独立 video-probe-temp 卷：
# 卷可用空间必须至少为 MAX_RESERVED_BYTES + MIN_FREE_BYTES，并额外预留运维水位。
# 当前命名卷只支持单 backend；多副本必须为每个实例配置独立配额/文件系统，禁止共享该卷或目录。
# 从旧 root runtime 升级时须按 README 在停机维护窗保留该卷并一次性迁移为 10001:10001，禁止删卷。
VIDEO_PROBE_MAX_CONCURRENT=2
VIDEO_PROBE_MAX_RESERVED_BYTES=4294967296
VIDEO_PROBE_MIN_FREE_BYTES=1073741824
VIDEO_PROBE_MAX_DURATION=PT10M
VIDEO_PROBE_MAX_PACKETS=2000000
# 续租间隔必须严格小于租约时长的一半；工作进程超过墙钟时限会被强制终止。
VIDEO_PROBE_LEASE_DURATION=PT2M
VIDEO_PROBE_LEASE_RENEW_INTERVAL=PT30S
VIDEO_PROBE_WORKER_MAX_HEAP_MB=256
# worker 会校验父 JVM 的 PID 与启动时刻；父 JVM 非正常退出后，worker 最多在该间隔内自行退出。
VIDEO_PROBE_PARENT_CHECK_INTERVAL=PT1S
# 持久探测卷 owner heartbeat + 过期孤儿清扫；TTL 必须显著大于单次探测墙钟。
# 目录仅供探测工件使用；独占锁失败会拒绝启动，不得通过删除锁文件绕过。
VIDEO_PROBE_ARTIFACT_HEARTBEAT_INTERVAL=PT30S
VIDEO_PROBE_ARTIFACT_OWNER_STALE_AFTER=PT2M
VIDEO_PROBE_ARTIFACT_ORPHAN_TTL=PT30M
VIDEO_PROBE_ARTIFACT_LEGACY_ORPHAN_TTL=PT24H
VIDEO_PROBE_ARTIFACT_CLEANUP_INTERVAL=PT5M
VIDEO_PROBE_ARTIFACT_CLEANUP_SCAN_LIMIT=10000
# 凭据硬化（WS-2，审计#1/#4）：以下两项生产必配、缺失即 fail-fast 拒绝启动。
# admin 超管初始口令的 bcrypt 哈希（不落明文）：生产启动时以此覆盖 V8 种子 admin 的公开口令并置 must_change_pwd=1；
# 未配则 AdminAccountInitializer 拒绝启动（不以公开固定口令 admin 起栈）。交互式生成示例（口令不进历史/进程参数）：
#   htpasswd -nBC 12 admin | sed 's/^admin://' | tr -d '\n'
# Compose dotenv 会对未加单引号的 `$...` 做变量插值；实际 bcrypt 必须保留下面的单引号，否则哈希会被截坏。
ADMIN_INITIAL_PASSWORD_HASH='$2b$10$replace-with-a-real-bcrypt-hash-before-production'
# 管理员新建/重置 STAFF 账号的初始口令：生产必须显式注入（dev 默认 ChangeMe123!）；
# 未配则 SecurityAdminServiceImpl 拒绝启动。
STAFF_INITIAL_PASSWORD='change-me-strong-staff-initial-password'
# 允许跨域的前端来源白名单（P1-7）：逗号分隔、含协议与端口、无路径/无末尾斜杠。
# 生产必须显式设为真实前端域名（如 https://cert.gpnu.edu.cn）；留空/不设时后端回退到仅本地
# localhost:5173（CorsConfig 默认），生产前端将被 CORS 拦截。allowCredentials=true 下不可用 "*"。
CORS_ALLOWED_ORIGINS=https://cert.example.edu.cn
# 后端直接复用 frontend 固定地址作为唯一可信代理；子网与两端地址须保持同一网段。
AUDIT_PROXY_SUBNET=172.30.42.0/24
FRONTEND_AUDIT_PROXY_IP=172.30.42.10
BACKEND_AUDIT_PROXY_IP=172.30.42.20
# 外层反代/WAF存在时填写其精确 IP/CIDR；直连部署保持该默认值，不信任远端 XFF。
INGRESS_TRUSTED_PROXY_CIDR=127.0.0.1/32
# 标准名册导入的进程级资源预算；异常明细上限在逐条入库和响应集合增长前生效。
EXCHANGE_IMPORT_MAX_FILE_BYTES=16777216
EXCHANGE_IMPORT_MAX_EXPANDED_BYTES=67108864
EXCHANGE_IMPORT_MAX_ROWS=20000
EXCHANGE_IMPORT_MAX_CELL_CHARACTERS=4096
EXCHANGE_IMPORT_MAX_ERROR_DETAILS=20000
# 预览 JSON 写入上限；默认 20 MiB，确保经 Base64 备份后不超过 32 MiB 单语句合同。
EXCHANGE_IMPORT_MAX_PREVIEW_JSON_BYTES=20971520

# ===== M14 外部接口预留开关（默认关闭，不影响一期） =====
PLATFORM_INTEGRATION_IDENTITY_ENABLED=false
PLATFORM_INTEGRATION_ACADEMIC_ENABLED=false
PLATFORM_INTEGRATION_STUDENT_REGISTRY_ENABLED=false
PLATFORM_INTEGRATION_ELECTRONIC_SIGNATURE_ENABLED=false
PLATFORM_INTEGRATION_ELECTRONIC_LICENSE_ENABLED=false
PLATFORM_INTEGRATION_SUPERIOR_PLATFORM_ENABLED=false
