# 复制为 .env 使用（.env 不入库）。生产部署用 docker-compose.yml 读取。
# ===== 镜像与端口 =====
APP_IMAGE_TAG=latest
BACKEND_PORT=8080
FRONTEND_PORT=80
# 注（Phase 41.1/41.3）：MySQL/Redis 生产不再 publish 端口到主机（仅内部 DNS 可达），
# 故无 MYSQL_PORT/REDIS_PORT——如需运维排障请用 docker exec 进容器。
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=teacher_cert
# 应用连接账号（Phase 41.1，P0-5）：非 root 最小权限，由 deploy/mysql-init/01-app-user.sh
# 在数据卷首次初始化时创建（仅 teacher_cert 库 DML+DDL，无 GRANT OPTION/SUPER/FILE/*.*）。
# 必须显式设置强密码，不可留空/沿用示例值。
DB_USERNAME=teacher_app
DB_PASSWORD=change-me-strong-app-db-password

# ===== Redis =====
# 生产加密码认证（Phase 41.3），必须显式设置强密码。
REDIS_PASSWORD=change-me-strong-redis-password

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=teacher-cert
# 浏览器可达的 MinIO API 根地址（不能使用 Compose 内部 DNS minio）。WS-5 启用 HTTPS 后必须改为 https。
MINIO_PUBLIC_ENDPOINT=http://files.example.edu.cn:9000
MINIO_REGION=us-east-1
MINIO_PRESIGN_EXPIRY_SECONDS=900
# MinIO 公网端点/CORS 故障时可临时设 false，视频和材料将回退为字节经应用上传。
MINIO_DIRECT_UPLOAD_ENABLED=true
# INITIATING/COMPLETING 超过该时限后允许新请求以 CAS 方式恢复，避免进程中断永久占槽。
MINIO_DIRECT_UPLOAD_INIT_TIMEOUT_SECONDS=120
MINIO_DIRECT_UPLOAD_COMPLETE_TIMEOUT_SECONDS=300
# 逗号分隔、含协议与端口。由 MinIO 的 MINIO_API_CORS_ALLOW_ORIGIN 在服务启动时读取；修改后需重建 MinIO 容器。
MINIO_CORS_ALLOWED_ORIGINS=https://cert.example.edu.cn

# ===== 后端 =====
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=change-me-at-least-64-characters-change-me-at-least-64-characters
JAVA_OPTS=-Xms512m -Xmx1024m
# 凭据硬化（WS-2，审计#1/#4）：以下两项生产必配、缺失即 fail-fast 拒绝启动。
# admin 超管初始口令的 bcrypt 哈希（不落明文）：生产启动时以此覆盖 V8 种子 admin 的公开口令并置 must_change_pwd=1；
# 未配则 AdminAccountInitializer 拒绝启动（不以公开固定口令 admin 起栈）。交互式生成示例（口令不进历史/进程参数）：
#   htpasswd -nBC 12 admin | sed 's/^admin://' | tr -d '\n'
# Compose dotenv 会对未加单引号的 `$...` 做变量插值；实际 bcrypt 必须保留下面的单引号，否则哈希会被截坏。
ADMIN_INITIAL_PASSWORD_HASH='$2b$10$replace-with-a-real-bcrypt-hash-before-production'
# 管理员新建/重置 STAFF 账号的初始口令：生产必须显式注入（dev 默认 ChangeMe123!）；
# 未配则 SecurityAdminServiceImpl 拒绝启动。
STAFF_INITIAL_PASSWORD='change-me-strong-staff-initial-password'
# 允许跨域的前端来源白名单（P1-7）：逗号分隔、含协议与端口、无路径/无末尾斜杠。
# 生产必须显式设为真实前端域名（如 https://cert.gpnu.edu.cn）；留空/不设时后端回退到仅本地
# localhost:5173（CorsConfig 默认），生产前端将被 CORS 拦截。allowCredentials=true 下不可用 "*"。
CORS_ALLOWED_ORIGINS=https://cert.example.edu.cn

# ===== M14 外部接口预留开关（默认关闭，不影响一期） =====
PLATFORM_INTEGRATION_IDENTITY_ENABLED=false
PLATFORM_INTEGRATION_ACADEMIC_ENABLED=false
PLATFORM_INTEGRATION_STUDENT_REGISTRY_ENABLED=false
PLATFORM_INTEGRATION_ELECTRONIC_SIGNATURE_ENABLED=false
PLATFORM_INTEGRATION_ELECTRONIC_LICENSE_ENABLED=false
PLATFORM_INTEGRATION_SUPERIOR_PLATFORM_ENABLED=false
