# 复制为 .env 使用（.env 不入库）。生产部署用 docker-compose.yml 读取。
# ===== 镜像与端口 =====
APP_IMAGE_TAG=latest
BACKEND_PORT=8080
FRONTEND_PORT=80
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=teacher_cert

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=teacher-cert

# ===== 后端 =====
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=change-me-at-least-64-characters-change-me-at-least-64-characters
JAVA_OPTS=-Xms512m -Xmx1024m

# ===== M14 外部接口预留开关（默认关闭，不影响一期） =====
PLATFORM_INTEGRATION_IDENTITY_ENABLED=false
PLATFORM_INTEGRATION_ACADEMIC_ENABLED=false
PLATFORM_INTEGRATION_STUDENT_REGISTRY_ENABLED=false
PLATFORM_INTEGRATION_ELECTRONIC_SIGNATURE_ENABLED=false
PLATFORM_INTEGRATION_ELECTRONIC_LICENSE_ENABLED=false
PLATFORM_INTEGRATION_SUPERIOR_PLATFORM_ENABLED=false
