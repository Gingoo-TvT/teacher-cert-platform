  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "axios": "^1.7.7",
    "echarts": "^5.5.1",
    "naive-ui": "^2.40.1",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^24.1.3",
    "playwright": "1.54.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
